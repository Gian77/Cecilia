// =============================================================================
// Cecilia-nf  —  nextflow.config
// Replaces config.yaml. All user-facing parameters live in params {}.
// USEARCH is not containerised: the binary is mounted from the host into every
// Singularity container via singularity.runOptions below. It is public domain
// (CC0-1.0) and fetched automatically — see the version policy below.
// =============================================================================

// workDir intentionally left on $HOME (the default, ${launchDir}/work). Research
// storage (/mnt/research/glbrc_group/...) looked appealing to dodge the $HOME
// 100G/125G quota, but it lives on a separate filesystem (ufs18, not the VAST
// mount $HOME uses) with real cross-node directory-visibility lag: a task's
// freshly-created work dir was routinely not yet visible to the compute node
// that picks it up, failing every retry. Manage $HOME usage instead by running
// `nextflow clean -f <session-id>` promptly after each completed/abandoned run
// (see README "Quick start"). A proper scratch allocation from ICER support
// would be the durable fix if run sizes outgrow this.
//
// UPDATE: run sizes have outgrown it. For anything beyond the ~10-sample test
// set, put BOTH the work dir and the outdir on scratch:
//
//   sbatch run_cecilia.sb -work-dir /mnt/scratch/benucci/cecilia_work \
//                         --outdir  /mnt/scratch/benucci/cecilia_outputs
//
// A ~500-sample run is roughly 50x the test data; $HOME cannot hold it. Note
// this is NOT the /mnt/research path that caused the visibility failures above
// — scratch (gs21) is a different filesystem and has been used successfully for
// long multi-hour jobs here, though not yet as a Nextflow workDir specifically.
// Scratch is inode-constrained (1M file limit, ~83% used), so run
// `nextflow clean -f -but nothing` after each run there too.

manifest {
    name            = 'Gian77/CECILIAv2'
    author          = 'Gian M. N. Benucci'
    homePage        = 'https://github.com/Gian77/CECILIAv2'
    description     = 'usearCh basEd ampliCon pIpeLine for Illumina dAta'
    mainScript      = 'cecilia.nf'
    nextflowVersion = '>=24.04.0'
    version         = '2.0.0'
}

params {

    help     = false   // set to true or pass --help to print usage and exit

    // -------------------------------------------------------------------------
    // INPUT / OUTPUT
    // -------------------------------------------------------------------------
    rawdata  = "${projectDir}/rawdata"
    outdir   = "${projectDir}/outputs"

    // -------------------------------------------------------------------------
    // TOOLS  (host paths, bound into containers)
    // -------------------------------------------------------------------------
    // USEARCH v11.0.667 is public domain (CC0-1.0) as of 2024, so the pipeline
    // downloads it on first run into .tools/ — nothing for the user to obtain
    // or install. The URL is pinned to a commit, not a branch, and the download
    // is checksum-verified before use. Point --usearch at an existing binary to
    // use that instead; it is then taken as-is (a hash mismatch only warns).
    usearch        = "${projectDir}/.tools/usearch11.0.667_i86linux64"
    usearch_fetch  = true
    usearch_url    = "https://raw.githubusercontent.com/rcedgar/usearch_old_binaries/699ee4c996cfd9f164035c61821ca191197d7bf7/bin/usearch11.0.667_i86linux64"
    usearch_sha256 = "a2b981fbef45e2ec981dc8ade3118f58356bc3dcc286d658a7fe298b36590ea8"

    // ---- USEARCH VERSION POLICY — SETTLED, DO NOT RE-TEST v12 ---------------
    // This pipeline is pinned to v11.0.667 deliberately. v12.0-beta1 was
    // evaluated head-to-head (2026-08-12, SLURM job 15370792, 7h09m: every one
    // of the baseline's 92 USEARCH calls replayed under v11 twice and v12 once,
    // with the v11-vs-v11 pass as the run-to-run noise floor). It was rejected
    // on three independent grounds:
    //
    //   1. v12 CANNOT run this pipeline. It ships 24 commands; 5 that the
    //      pipeline needs were removed: -filter_phix, -fastq_eestats2,
    //      -sortbylength, -fastx_getseqs, -fastx_info. 21 of 92 calls affected.
    //   2. v12 REGRESSES. It segfaults on -closed_ref with real, non-empty
    //      input at 200/225/250 bp, where v11 succeeds. v11 was deterministic
    //      across two independent replays.
    //   3. v12 FIXES NOTHING WE CARE ABOUT. The -otutab exit-139 segfault is
    //      identical in both versions, because its trigger is an empty -otus
    //      FASTA, not a binary defect. That was the only argument for moving.
    //
    // Full evidence, including the replay harness and per-call results, lives
    // in testing/usearch_v11_v12/ (gitignored, kept on scratch).
    // Do not spend time re-running this comparison.

    // -------------------------------------------------------------------------
    // DATABASES
    // -------------------------------------------------------------------------
    // sintax_db is passed through file() in the workflow, so Nextflow resolves
    // and bind-mounts it for us — a /mnt/research path is safe here.
    sintax_db     = "/mnt/research/glbrc_group/benuccigmn/DATABASES/SILVA/rRNA_databases/SILVA_138_SSURef_tax_silva_bact_arch_sintax.fasta"

    // closedRef_db MUST be a real path, not a /mnt/research one. It is the only
    // database interpolated straight into a task script (CLOSED_REF_OTU's -db),
    // so the container opens it directly rather than through a staged input.
    // /mnt/research is a CVMFS symlink farm:
    //     /mnt/research             -> /cvmfs/directory_links.icer.msu.edu/rsdirectories
    //     /mnt/research/glbrc_group -> /gpfs/home/rs/glbrc_group
    // and /cvmfs is NOT bind-mounted into containers on compute nodes, so that
    // chain dangles at the first hop and usearch reports
    //     "Cannot open ..., errno=2 No such file or directory"
    // on every retry. Verified on a compute node: /mnt/research/... FAILED,
    // /mnt/ufs18/rs/... READABLE (covered by the -B /mnt that Nextflow adds).
    // Use `realpath <file>` to convert a /mnt/research path before setting this.
    closedRef_db  = "/mnt/ufs18/rs/glbrc_group/benuccigmn/DATABASES/CLOSED_REF_DBs/syncom_n40_ref_seeds.fasta"

    // -------------------------------------------------------------------------
    // DNA MARKER & READ LAYOUT
    // -------------------------------------------------------------------------
    dna_marker = "16S"
    paired     = true    // true = R1+R2, false = single-end

    // -------------------------------------------------------------------------
    // PIPELINE FLOW FLAGS
    // -------------------------------------------------------------------------
    assemble           = true
    rename             = true
    primers            = true
    stripleft          = false
    stripleft_bp       = 0
    test_length        = false   // optional 150–300 bp length sweep (off by default)
    cluster_otu        = true
    cluster_asv        = true
    cluster_asv_to_otu = true    // requires cluster_asv = true
    cluster_swarm      = true
    closed_ref_otu     = true
    sintax_taxonomy    = true
    summary_table      = true    // per-sample read tracking + OTU summary TSVs

    // -------------------------------------------------------------------------
    // PRIMER SEQUENCES
    // -------------------------------------------------------------------------
    fwd_primer    = "GTGCCAGCMGCCGCGGTAA"     // 515F  (Parada / Caporaso)
    rev_primer    = "GGACTACHVGGGTWTCTAAT"     // 806R  (Apprill / Caporaso)
    rev_primer_rc = "ATTAGAWACCCBDGTAGTCC"     // 806R  reverse complement

    // -------------------------------------------------------------------------
    // QUALITY FILTERING
    // -------------------------------------------------------------------------
    max_eerr       = 1.0
    filter_lengths = [200, 225, 250]   // truncation lengths tested in FILTER_MAXEE
    user_length    = 290               // extra user-defined truncation length
    min_overlap    = 0
    count_start    = "01"

    // -------------------------------------------------------------------------
    // CLUSTERING
    // -------------------------------------------------------------------------
    otu_min_size  = 1
    zotu_min_size = 8
    clustering_id = 0.97

    // -------------------------------------------------------------------------
    // TAXONOMY
    // -------------------------------------------------------------------------
    sintax_cutoff = 0.8

    // -------------------------------------------------------------------------
    // SLURM
    // -------------------------------------------------------------------------
    slurm_account = "glbrc"
}

// =============================================================================
// PER-PROCESS RESOURCES AND CONTAINERS
// Containers for USEARCH steps use ubuntu:22.04; the binary is bound from host.
// =============================================================================
process {
    executor       = 'slurm'
    clusterOptions = "--account=${params.slurm_account}"

    withName: 'DECOMPRESS' {
        cpus      = 16
        memory    = '64 GB'
        time      = '15m'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'FASTQC' {
        cpus          = 8
        memory        = '32 GB'
        time          = '1h'
        container     = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
        // SIGBUS on parallel filesystems is transient; retry once before failing
        errorStrategy = 'retry'
        maxRetries    = 1
    }
    withName: 'REMOVE_PHIX' {
        cpus      = 8
        memory    = '32 GB'
        time      = '30m'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'ASSEMBLE_READS' {
        cpus      = 16
        memory    = '128 GB'
        time      = '12h'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'RENAME_READS' {
        cpus      = 8
        memory    = '32 GB'
        time      = '30m'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'STRIP_PRIMERS' {
        cpus      = 16
        memory    = '32 GB'
        time      = '30m'
        container = 'quay.io/biocontainers/cutadapt:5.2--py312h247cb63_1'
    }
    withName: 'POOL_READS' {
        cpus      = 4
        memory    = '16 GB'
        time      = '15m'
        container = 'quay.io/biocontainers/seqtk:1.4--he4a0461_1'
    }
    withName: 'EE_STATS' {
        cpus      = 8
        memory    = '32 GB'
        time      = '4h'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'TEST_LENGTH' {
        cpus      = 16
        memory    = '128 GB'
        time      = '4h'
        // rocker/tidyverse includes tidyverse + ggplot2; USEARCH is bind-mounted
        container = 'docker://rocker/tidyverse:4.3.1'
    }
    withName: 'FILTER_MAXEE' {
        cpus      = 8
        memory    = '32 GB'
        time      = '1h'
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }
    withName: 'DEREPLICATE' {
        cpus      = 8
        memory    = '32 GB'
        time      = '4h'
        container = 'quay.io/biocontainers/swarm:3.1.6--h9948957_0'
    }
    // The 5 blocks below all call `usearch -otutab`, which can segfault
    // (exit 139). Root cause is now known: -otutab crashes instead of
    // erroring when handed an EMPTY -otus FASTA. Confirmed NOT a SLURM
    // cpu-allocation mismatch (identical at cpus=16 and cpus=128, on 128-
    // and 192-core nodes), and NOT specific to v11 — v12 segfaults on the
    // very same calls (see the version note at the top of this file).
    //
    // retry therefore cannot clear it: an empty input fails deterministically
    // on every attempt. retry is kept only as cheap insurance for genuinely
    // transient faults, mirroring the FASTQC SIGBUS retry above. The real
    // fix for a crash here is to guard the producing step so it never emits
    // an empty FASTA — as CLOSED_REF_OTU does with `if [[ -s hit_ids ]]`.
    withName: 'CLUSTER_UPARSE' {
        cpus          = 32
        memory        = '256 GB'
        time          = '10h'
        container     = 'docker://ubuntu:22.04'
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName: 'CLUSTER_UNOISE' {
        cpus          = 16
        memory        = '128 GB'
        time          = '10h'
        container     = 'docker://ubuntu:22.04'
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName: 'CLUSTER_ASV_TO_OTU' {
        cpus          = 16
        memory        = '128 GB'
        time          = '4h'
        container     = 'docker://ubuntu:22.04'
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName: 'CLOSED_REF_OTU' {
        cpus          = 16
        memory        = '128 GB'
        time          = '4h'
        container     = 'docker://ubuntu:22.04'
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName: 'CLUSTER_SWARM' {
        cpus          = 16
        memory        = '64 GB'
        time          = '4h'
        container     = 'quay.io/biocontainers/swarm:3.1.6--h9948957_0'
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName: 'BUILD_SINTAX_DB' {
        cpus      = 4
        memory    = '32 GB'
        time      = '1h'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'TAXONOMY_SINTAX' {
        cpus      = 32
        memory    = '392 GB'
        time      = '10h'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'SUMMARIZE_COUNTS' {
        cpus      = 4
        memory    = '32 GB'
        time      = '30m'
        container = 'docker://ubuntu:22.04'
    }

    withName: 'COLLECT_RESULTS' {
        cpus      = 4
        memory    = '32 GB'
        time      = '15m'
        container = 'docker://ubuntu:22.04'
    }
}

// =============================================================================
// SINGULARITY
// Mounts the host /mnt/research and /mnt/home trees so USEARCH, databases,
// and isolate FASTAs are all reachable inside every container.
// =============================================================================
singularity {
    enabled    = true
    autoMounts = true
    // Persistent image cache on research storage — avoids re-pulling on every run
    cacheDir   = "/mnt/research/glbrc_group/benuccigmn/singularity_cache"
    // Bind host research+home trees (databases) and /tmp (JVM temp I/O). The
    // projectDir bind is what makes the auto-fetched USEARCH in .tools/ visible
    // inside containers when the pipeline lives outside the trees named above
    // (autoMounts covers it only when projectDir is also the launch directory).
    runOptions = "--bind ${projectDir}:${projectDir} --bind /mnt/ffs24:/mnt/ffs24 --bind /mnt/research:/mnt/research --bind /mnt/home:/mnt/home --bind /tmp:/tmp"
}

// =============================================================================
// PROFILES
// =============================================================================
profiles {
    slurm {
        process.executor = 'slurm'
    }
    local {
        process.executor    = 'local'
        singularity.enabled = false
    }
    test {
        process.executor    = 'local'
        singularity.enabled = false
        params.test_length  = false
        params.cluster_swarm = false
    }
}

// =============================================================================
// REPORTING  (written to outdir after each run)
// =============================================================================
report {
    enabled   = true
    file      = "${params.outdir}/cecilia_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/cecilia_timeline.html"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/cecilia_dag.html"
    overwrite = true
}
