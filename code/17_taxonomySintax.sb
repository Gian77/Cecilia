#!/bin/bash -login

#SBATCH --time=09:59:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --job-name=17_Sintax
#SBATCH -A glbrc

set -euo pipefail

# -----------------------------------------------------------------------------
# HEADER
# -----------------------------------------------------------------------------
cat << 'EOF'
###############################################################################
# Cecilia v.1.0 - usearCh basEd ampliCon pIpeLine for Illumina dAta
# MIT LICENSE - Copyright © 2025 Gian M.N. Benucci, Ph.D.
# Email: benucci@msu.edu
###############################################################################
EOF

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
cd "${SLURM_SUBMIT_DIR}"
cores="${SLURM_CPUS_PER_TASK}"
RAM="${SLURM_MEM_PER_NODE:-64000}"

echo "===> Running script: 17_taxonomySintax.sb"

# Load config
source ../config.yaml

# -----------------------------------------------------------------------------
# SETUP DIRECTORIES
# -----------------------------------------------------------------------------
input_dir="$project_dir/outputs/11_clustered_otu_asv_usearch"
output_dir="$project_dir/outputs/13_taxonomy_sintax"
mkdir -p "$output_dir"

echo -e "\n========== Sub-directories ==========\n"
echo "Input directory : $input_dir"
echo "Output directory: $output_dir"

# -----------------------------------------------------------------------------
# ASSIGN TAXONOMY BASED ON DNA MARKER
# -----------------------------------------------------------------------------
echo -e "\n========== Check if to Decompress The $sintax_db database... ==========\n"
if file "$sintax_db" | grep -q 'gzip compressed'; then
    echo "DB is gzipped. Decompressing $sintax_db"
    uncompressed="${sintax_db%.gz}"
    if [ ! -f "$uncompressed" ]; then
        gunzip "$sintax_db"
        sintax_db="$uncompressed"
    else
        echo "Uncompressed file $uncompressed already exists. Skipping decompression."
        sintax_db="$uncompressed"
    fi
else
    echo "$sintax_db is not gzipped. Continuing..."
fi

# -----------------------------------------------------------------------------
# BUILD SINTAX DATABASE
# -----------------------------------------------------------------------------
echo -e "\n========== Building SINTAX database ==========\n"
$USEARCH \
    -makeudb_usearch "$sintax_db" \
    -output "$output_dir/$(basename "${sintax_db%.fasta}").udb"

# -----------------------------------------------------------------------------
# ASSIGN TAXONOMY TO EACH FASTA FILE
# -----------------------------------------------------------------------------
for file in "$input_dir"/*.fasta; do
    [ -f "$file" ] || continue
    echo -e "\n========== Assigning taxonomy for $(basename "$file") ==========\n"
    file_name=$(basename "$file" .fasta)

    $USEARCH \
        -sintax "$file" \
        -db "$output_dir/$(basename "${sintax_db%.fasta}").udb" \
        -tabbedout "$output_dir/${file_name}.sintax" \
        -strand both \
        -sintax_cutoff 0.8 \
        -threads "$cores"
done

# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo -e "\n========== Contents of $output_dir ==================\n"
ls -lh "$output_dir"
echo
echo "Working directory: $(pwd)"

# -----------------------------------------------------------------------------
# LOG
# -----------------------------------------------------------------------------
echo -e "\n========= Sbatch log =========\n"
sacct -u "$USER" -j "$SLURM_JOB_ID" --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem || true
scontrol show job "$SLURM_JOB_ID" || true

# Move SLURM log to slurms folder
mv "$project_dir"/code/slurm-"$SLURM_JOB_ID"* "$project_dir"/slurms/17_taxonomySintax.slurm 2>/dev/null || true
