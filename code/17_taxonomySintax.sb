#!/bin/bash -login

#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --job-name=17_taxonomy
#SBATCH -A shade-cole-bonito

set -euo pipefail

# -----------------------------------------------------------------------------
# HEADER
# -----------------------------------------------------------------------------
cat << 'EOF'
###############################################################################
# Cecilia v.1.0 - usearCh basEd ampliCon pIpeLine for Illumina dAta
# MIT LICENSE - Copyright © 2025 Gian M.N. Benucci, Ph.D.
# Email: benucci@msu.edu
###############################################################################
EOF

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
cd "${SLURM_SUBMIT_DIR}"
cores="${SLURM_CPUS_PER_TASK}"
RAM="${SLURM_MEM_PER_NODE:-64000}"

echo "===> Running script: 17_taxonomy_sintax.sb"

# Load config
source ../config.yaml

# -----------------------------------------------------------------------------
# SETUP DIRECTORIES
# -----------------------------------------------------------------------------
input_dir="$project_dir/outputs/11_clustered_otu_asv_usearch"
output_dir="$project_dir/outputs/17_taxonomy_sintax"
mkdir -p "$output_dir"

echo -e "\n========== Sub-directories ==========\n"
echo "Input directory : $input_dir"
echo "Output directory: $output_dir"

# -----------------------------------------------------------------------------
# ASSIGN TAXONOMY BASED ON DNA MARKER
# -----------------------------------------------------------------------------
cd "$input_dir"

if [[ "$DNAmarker" == "ITS" || "$DNAmarker" == "16S" ]]; then
    # Decompress reference DB if needed
    if file "$euk_db" | grep -q 'gzip compressed'; then
        echo "Decompressing $euk_db"
        gunzip "$euk_db"
        euk_db="${euk_db%.gz}"
    else
        echo "$euk_db is not gzipped. Continuing..."
    fi

    # Build database
    echo -e "\n========== Building SINTAX database ==========\n"
    $USEARCH \
        -makeudb_usearch "$euk_db" \
        -output "$output_dir/$(basename "${euk_db%.fasta}").udb"

    # Assign taxonomy to each FASTA file
    for file in *.fasta; do
        [ -f "$file" ] || continue
        echo -e "\n========== Assigning taxonomy for $(basename "$file") ==========\n"
        file_name=$(basename "$file" .fasta)

        $USEARCH \
            -sintax "$file" \
            -db "$output_dir/$(basename "${euk_db%.fasta}").udb" \
            -tabbedout "$output_dir/${file_name}.sintax" \
            -strand both \
            -sintax_cutoff 0.8 \
            -threads "$cores"
    done
else
    echo "ERROR: Unsupported DNAmarker type '$DNAmarker'. Only 'ITS' and '16S' are allowed. 
    If using a different marker modify 17_taxonomySintax.sb"
    exit 1
fi

# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo -e "\n========== Contents of $output_dir ==================\n"
ls -lh "$output_dir"
echo
echo "Working directory: $(pwd)"

# -----------------------------------------------------------------------------
# LOG
# -----------------------------------------------------------------------------
echo -e "\n========= Sbatch log =========\n"
sacct -u "$USER" -j "$SLURM_JOB_ID" --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem || true
scontrol show job "$SLURM_JOB_ID" || true
mv "$project_dir"/code/slurm-"$SLURM_JOB_ID"* "$project_dir"/slurms/17_taxonomy_sintax.slurm
