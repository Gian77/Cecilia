#!/bin/bash -login

#SBATCH --time=00:30:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --job-name=03_phix_removal

set -euo pipefail  # safer bash behavior

# -----------------------------------------------------------------------------
# HEADER
# -----------------------------------------------------------------------------
cat << 'EOF'
###############################################################################
# Cecilia v.2.0 - usearCh basEd ampliCon pIpeLine for Illumina dAta
# MIT License - Copyright © 2025 Gian M.N. Benucci, Ph.D.
# Email: benucci@msu.edu
###############################################################################
EOF

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
cd "${SLURM_SUBMIT_DIR}"
cores=${SLURM_CPUS_PER_TASK}
RAM=${SLURM_MEM_PER_NODE:-32000}

echo "===> Running script: 03_removePhix-usearch.sb"

# Load config
source ../config.yaml

# -----------------------------------------------------------------------------
# SETUP DIRECTORIES
# -----------------------------------------------------------------------------
output_dir="$project_dir/outputs/03_removePhix_usearch"
input_dir="$project_dir/outputs/01_decompressed"
slurm_dir="$project_dir/slurms"
stats_dir="$project_dir/stats"

echo -e "\n========== Creating necessary directories ==========\n"
for dir in "$output_dir" "$slurm_dir" "$stats_dir"; do
    if [ ! -d "$dir" ]; then
        echo "Creating directory: $dir"
        mkdir -p "$dir"
    else
        echo "Directory already exists: $dir"
    fi
done

# -----------------------------------------------------------------------------
# CHECK COMPLETION
# -----------------------------------------------------------------------------
if compgen -G "$output_dir/*nophix.fastq" > /dev/null; then
    echo -e "\nOutput files already exist. This step appears complete. Exiting.\n"
    exit 0
fi

# -----------------------------------------------------------------------------
# PHIX FILTERING
# -----------------------------------------------------------------------------
cd "$input_dir" || { echo "Error: Failed to cd into $input_dir"; exit 1; }

echo -e "\nWarning! If you fastq files have _R1_ and _R2_ as part of the actual 
file name, or forward and reverse read files have just _1 and _2, then you should
rename your files or change this script accrodingly."

if [[ "$R1" == "yes" && "$R2" == "yes" ]]; then
    echo -e "\n========== Paired-end mode ==========\n"

    ls *R[12]*.fastq > paired.list

    while read -r R1 && read -r R2; do
        echo -e "\nProcessing paired files: $R1 / $R2"

        "$USEARCH" \
            -filter_phix "$R1" \
            -reverse "$R2" \
            -threads "$cores" \
            -output "$output_dir/${R1%.fastq}_nophix.fastq" \
            -output2 "$output_dir/${R2%.fastq}_nophix.fastq"

    done < paired.list

elif [[ "$R1" == "yes" && "$R2" == "no" ]]; then
    echo -e "\n========== Single-end R1-only mode ==========\n"

    ls *R1*.fastq > paired.list

    for file in *R1*.fastq; do
        echo "Processing single-end R1: $file"
        "$USEARCH" \
            -filter_phix "$file" \
            -threads "$cores" \
            -output "$output_dir/${file%.fastq}_nophix.fastq" \
            -alnout "$output_dir/${file%.fastq}_nophix_hits.txt"

    	rm "$output_dir/${file%.fastq}_nophix_hits.txt"

    done

elif [[ "$R1" == "no" && "$R2" == "yes" ]]; then
    echo -e "\n========== Single-end R2-only mode ==========\n"

    ls *R2*.fastq > paired.list

    for file in *R2*.fastq; do
        echo "Processing single-end R2: $file"
        "$USEARCH" \
            -filter_phix "$file" \
            -threads "$cores" \
            -output "$output_dir/${file%.fastq}_nophix.fastq" \
            -alnout "$output_dir/${file%.fastq}_nophix_hits.txt"

        rm -alnout "$output_dir/${file%.fastq}_nophix_hits.txt"
    done

else
    echo "Invalid configuration: R1=$R1, R2=$R2"
    exit 1
fi

# -----------------------------------------------------------------------------
# COUNT FILTERED READS
# -----------------------------------------------------------------------------
echo -e "\n========== Counting filtered reads ==========\n"
> "$stats_dir/2.nophix.counts"

for file in "$output_dir"/*nophix.fastq; do
    [ -f "$file" ] || continue
    count=$(($(wc -l < "$file") / 4))
    echo "$(basename "$file") : $count" | tee -a "$stats_dir/2.nophix.counts"
done

# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo -e "\n========== Contents of "$output_dir" ==================\n"
ls -lh "$output_dir"

echo "Working directory: $(pwd)"

# -----------------------------------------------------------------------------
# SLURM JOB LOGGING
# -----------------------------------------------------------------------------
echo -e "\n========== SLURM Job Info ==========\n"
sacct -u "$USER" -j "$SLURM_JOB_ID" --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem
scontrol show job "$SLURM_JOB_ID"
mv "$project_dir/code/slurm-$SLURM_JOB_ID"* "$slurm_dir/03_removePhix-usearch.slurm" 2>/dev/null || true
