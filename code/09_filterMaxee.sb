#!/bin/bash -login

#SBATCH --time=00:59:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --job-name=09_filterMaxee
#SBATCH -A glbrc

set -euo pipefail

# -----------------------------------------------------------------------------
# HEADER
# -----------------------------------------------------------------------------
cat << 'EOF'
###############################################################################
# Cecilia v.1.0 - usearCh basEd ampliCon pIpeLine for Illumina dAta
# MIT LICENSE - Copyright © 2022 Gian M.N. Benucci, Ph.D.
# Email: benucci@msu.edu
###############################################################################
EOF

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
cd "${SLURM_SUBMIT_DIR}"
cores=${SLURM_CPUS_PER_TASK}
RAM=${SLURM_MEM_PER_NODE:-32000}

echo "===> Running script: 09_filterMaxee_usearch.sb"

source ../config.yaml

output_dir="$project_dir/outputs/09_filterMaxee_usearch"
mkdir -p "$output_dir"

if [ "$(ls -A "$output_dir")" ]; then
    echo -e "\nDirectory exists and is not empty! This step was already performed. Exiting...\n"
    exit 0
fi

# -----------------------------------------------------------------------------
# INPUT FILE
# -----------------------------------------------------------------------------
if [[ "$stripleft" == "yes" ]]; then
    source_file="$project_dir/outputs/07_readTrimDemux_usearch/trimmed.fastq"
    echo -e "\nUsing trimmed reads: $source_file\n"
else
    source_file="$project_dir/outputs/06_primerStrip_cutadapt/pooled.fastq"
    echo -e "\nUsing non-trimmed reads: $source_file\n"
fi

# -----------------------------------------------------------------------------
# FILTERING USING MAX EXPECTED ERRORS
# -----------------------------------------------------------------------------
echo -e "\n========== Filtering with max expected error = $max_Eerr ==========\n"

for len in 200 225 250; do
    out_file="$output_dir/filtered_${len}bp.fastq"

    $USEARCH -fastq_filter "$source_file" \
        -fastq_maxee "$max_Eerr" \
        -fastq_trunclen "$len" \
        -fastq_maxns 0 \
        -fastqout "$out_file"

    # Remove the output file if it is empty (no reads passed)
    if [[ ! -s "$out_file" ]]; then
        echo "Warning: No reads passed filter for length $len. Removing empty file: $out_file"
        rm -f "$out_file"
    fi
done

#for len in 200 225 250; do
#    $USEARCH -fastq_filter "$source_file" \
#        -fastq_maxee "$max_Eerr" \
#        -fastq_trunclen "$len" \
#        -fastq_maxns 0 \
#        -fastqout "$output_dir/filtered_${len}bp.fastq"
#done

# Optional user-defined length
#if [[ -v user_length && "$user_length" =~ ^[0-9]+$ ]]; then
#    echo -e "\nFiltering with user-defined length: $user_length bp\n"
#    $USEARCH -fastq_filter "$source_file" \
#        -fastq_maxee "$max_Eerr" \
#       -fastq_trunclen "$user_length" \
#        -fastq_maxns 0 \
#        -fastqout "$output_dir/filtered_${user_length}bp.fastq"
#else
#    echo -e "\nNo valid user_length defined in config.yaml. Skipping custom length...\n"
#fi

if [[ -v user_length && "$user_length" =~ ^[0-9]+$ ]]; then
    echo -e "\nFiltering with user-defined length: $user_length bp\n"
    out_file="$output_dir/filtered_${user_length}bp.fastq"

    $USEARCH -fastq_filter "$source_file" \
        -fastq_maxee "$max_Eerr" \
        -fastq_trunclen "$user_length" \
        -fastq_maxns 0 \
        -fastqout "$out_file"

    if [[ ! -s "$out_file" ]]; then
        echo "Warning: No reads passed filter for user-defined length $user_length. Removing empty file: $out_file"
        rm -f "$out_file"
    fi
fi


# -----------------------------------------------------------------------------
# FINAL QUALITY CHECK WITH FASTQC
# -----------------------------------------------------------------------------
echo -e "\n========== Running FastQC ==========\n"
module purge
module load Miniforge3
conda activate fastqc
echo "FastQC version: $(fastqc --version)"

# Gather all filtered fastq files
fastqc "$output_dir"/filtered_*bp.fastq \
    --threads "$cores" \
    --outdir "$output_dir"

conda deactivate

# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo -e "\n========== Contents of $output_dir ==================\n"
ls -lh "$output_dir"
echo
echo "Working directory: $(pwd)"

# -----------------------------------------------------------------------------
# SLURM LOG
# -----------------------------------------------------------------------------
echo -e "\n========= Sbatch log ==========\n"
sacct -u "$USER" -j "$SLURM_JOB_ID" --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem
scontrol show job "$SLURM_JOB_ID"

# Move SLURM log to slurms folder
mv "$project_dir"/code/slurm-"$SLURM_JOB_ID"* "$project_dir"/slurms/09_filterMaxee_usearch.slurm 2>/dev/null || true
