#!/bin/bash -login

#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=256G
#SBATCH --job-name=12_clusterUNOISE
#SBATCH -A shade-cole-bonito

set -euo pipefail

# -----------------------------------------------------------------------------
# HEADER
# -----------------------------------------------------------------------------
cat << 'EOF'
###############################################################################
# Cecilia v.1.0 - usearCh basEd ampliCon pIpeLine for Illumina dAta
# MIT LICENSE - Copyright © 2022 Gian M.N. Benucci, Ph.D.
# Email: benucci@msu.edu
###############################################################################
EOF

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
cd "${SLURM_SUBMIT_DIR}"
cores="${SLURM_CPUS_PER_TASK}"
RAM="${SLURM_MEM_PER_NODE:-256000}"

echo "===> Running script: 16_taxonomyConstax.sb"

# Load config
source ../config.yaml

# -----------------------------------------------------------------------------
# SETUP DIRECTORIES
# -----------------------------------------------------------------------------
echo -e "\n========== Setting up output directory ==========\n"
output_dir="$project_dir/outputs/12_taxonomy_constax"
input_dir="$project_dir/outputs/11_clustered_otu_asv_usearch"
mkdir -p "$output_dir"
mkdir -p "$output_dir/extra"

echo -e "\n========== Sub-directories ==========\n"
echo "Input directory : $input_dir"
echo "Output directory: $output_dir"
echo "Extra files directory: $output_dir/extra"

# -----------------------------------------------------------------------------
# CONDA ENVIRONMENT
# -----------------------------------------------------------------------------
echo -e "\n========== Activating CONSTAX2 environment ==========\n"
module purge
module load Miniforge3
set +u
conda activate constax2
set -u

# -----------------------------------------------------------------------------
# TRAIN DATABASE (IF REQUESTED)
# -----------------------------------------------------------------------------
if [[ "$train_db" == "yes" ]]; then
    echo -e "\n========== Training reference database $constax_db ==========\n"
    first_file=$(ls "$input_dir"/otus*.fasta | head -1)
    awk '/^>/ {n++} n>2 {exit} {print}' "$first_file" > "$output_dir/train.fasta"

    (
        cd "$output_dir"
        constax \
            --num_threads "$cores" \
            --mem "$RAM" \
            --db "$constax_db" \
            --input train.fasta \
            --train \
            --trainfile "$train_files/" \
            --output ./ \
            --blast \
            --sintax_path "$SINTAX" \
            --rdp_path "$RDP" \
            --constax_path "$CONSTAX"
    )
else
    echo -e "Using pre-trained reference database. Skipping training step."
fi

echo -e "\nTraining files:\n$(ls -l "$trainfiles_euk/")"

# -----------------------------------------------------------------------------
# TAXONOMY ASSIGNMENT
# -----------------------------------------------------------------------------
for file in "$input_dir"/*.fasta; do
    [ -f "$file" ] || continue
    echo -e "\n$file\n"
    file_base=$(basename "$file")
    file_name="${file_base%%.*}"

    echo -e "\n========== Assigning taxonomy for $file_base ==========\n"

    (
        cd "$output_dir"
        constax \
            --num_threads "$cores" \
            --mem "$RAM" \
            --db "$euk_db" \
            --trainfile "$train_files/" \
            --input "$file" \
            --isolates "$bonito_isolates" \
            --isolates_query_coverage 90 \
            --isolates_percent_identity 90 \
            --high_level_db "$euk_db" \
            --high_level_query_coverage 60 \
            --high_level_percent_identity 60 \
            --tax "constax_${file_name}/" \
            --output "constax_${file_name}/" \
            --conf "$constax_conf" \
            --blast \
            --sintax_path "$SINTAX" \
            --rdp_path "$RDP" \
            --constax_path "$CONSTAX"
    )
done

conda deactivate

# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo -e "\n========== Contents of $output_dir ==================\n"
ls -lh "$output_dir"
echo
echo "Working directory: $(pwd)"
# -----------------------------------------------------------------------------
# SLURM LOG
# -----------------------------------------------------------------------------
echo -e "\n========= SLURM Job Info ========="
echo -e "\n$(sacct -u "$MSUusername" -j "$SLURM_JOB_ID" --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem)\n" || true
echo
scontrol show job "$SLURM_JOB_ID" || true
# Move SLURM log to slurms folder
mv "$project_dir/code/slurm-$SLURM_JOB_ID"* "$project_dir/slurms/14.1_EukTaxonomy_OTU_constax.slurm" 2>/dev/null || true
