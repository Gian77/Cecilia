#!/bin/bash -login

#SBATCH --time=03:59:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --job-name=07_eestat2
#SBATCH -A shade-cole-bonito

set -euo pipefail

# -----------------------------------------------------------------------------
# HEADER
# -----------------------------------------------------------------------------
cat << 'EOF'
###############################################################################
# Cecilia v.1.0 - usearCh basEd ampliCon pIpeLine for Illumina dAta
# MIT LICENSE - Copyright © 2022 Gian M.N. Benucci, Ph.D.
# Email: benucci@msu.edu
###############################################################################
EOF

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
cd "${SLURM_SUBMIT_DIR}"
cores=${SLURM_CPUS_PER_TASK}
RAM=${SLURM_MEM_PER_NODE:-32000}

echo "===> Running script: 07_readTrimDemux-usearch.sb"

# Load config
source ../config.yaml

# -----------------------------------------------------------------------------
# SETUP DIRECTORIES
# -----------------------------------------------------------------------------
input_dir="$project_dir/outputs/06_primerStrip_cutadapt"
output_dir="$project_dir/outputs/07_readTrimDemux_usearch"
slurm_dir="$project_dir/slurms"
stats_dir="$project_dir/stats"

echo -e "\n========== Creating necessary directories ==========\n"
for dir in "$output_dir" "$slurm_dir" "$stats_dir"; do
    if [ ! -d "$dir" ]; then
        echo "Creating directory: $dir"
        mkdir -p "$dir"
    else
        echo "Directory already exists: $dir"
    fi
done

# -----------------------------------------------------------------------------
# CHECK COMPLETION
# -----------------------------------------------------------------------------
if [ -f "$output_dir/eestats2.results" ]; then
    echo -e "\nEEstats2 results already exist. This step appears complete. Exiting.\n"
    exit 0
fi

# -----------------------------------------------------------------------------
# TRIM AND GENERATE EESTATS2
# -----------------------------------------------------------------------------
cd "$input_dir" || { echo "ERROR: Cannot cd into $input_dir"; exit 1; }

echo -e "\n========== Running fastq_filter and EEstats2 ==========\n"

if [[ "$stripleft" == "yes" ]]; then
    echo -e "\nYou chose to remove $stripleft_bp bp from the front of reads."

    "$USEARCH" \
        -fastq_filter "$input_dir/pooled.fastq" \
        -fastq_stripleft "$stripleft_bp" \
        -fastqout "$output_dir/trimmed.fastq"

    bash "$project_dir/code/compareSeqQual.sh" "$input_dir"

    "$USEARCH" \
        -fastq_eestats2 "$output_dir/trimmed.fastq" \
        -output "$output_dir/eestats2.results" \
        -length_cutoffs 100,500,1

elif [[ "$stripleft" == "no" ]]; then
    echo -e "\nYou chose NOT to strip bases. Running eestats2 on untrimmed pooled reads."

    bash "$project_dir/code/compareSeqQual.sh" "$input_dir"

    "$USEARCH" \
        -fastq_eestats2 "$input_dir/pooled.fastq" \
        -output "$output_dir/eestats2.results" \
        -length_cutoffs 100,500,1
fi

# -----------------------------------------------------------------------------
# COUNT READS
# -----------------------------------------------------------------------------
echo -e "\n========== Counting reads per sample ==========\n"

count_file="$stats_dir/07_trimmed.counts"
> "$count_file"

if [ -f "$output_dir/trimmed.fastq" ]; then
    fastq_file="$output_dir/trimmed.fastq"
    count_file="$stats_dir/07_trimmed.counts"
    echo "Using trimmed file: $fastq_file"
else
    fastq_file="$input_dir/pooled.fastq"
    count_file="$stats_dir/07_pooled.counts"
    echo "Using pooled file: $fastq_file"
fi

> "$count_file"

# Extract sample IDs and count reads per sample
sed -n '1~4p' "$fastq_file" | \
    sed 's/^@//' | \
    awk -F'.' '{print $1}' | \
    sort | uniq -c | \
    awk '{printf "%s : %s\n", $2, $1}' | tee -a "$count_file"

# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo -e "\n========== Contents of "$output_dir" ==================\n"
ls -lh "$output_dir"
echo
echo "Working directory: $(pwd)"

# -----------------------------------------------------------------------------
# SLURM JOB LOGGING
# -----------------------------------------------------------------------------
echo -e "\n========== SLURM Job Info ==========\n"
echo "Working directory: $(pwd)"
sacct -u "$USER" -j "$SLURM_JOB_ID" --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem
scontrol show job "$SLURM_JOB_ID"

mv "$project_dir/code/slurm-$SLURM_JOB_ID"* "$slurm_dir/07_readTrimDemux-usearch.slurm" 2>/dev/null || true
