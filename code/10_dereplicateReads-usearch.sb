#!/bin/bash -login

#SBATCH --time=03:59:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --job-name=10_derep
#SBATCH -A shade-cole-bonito

set -euo pipefail

# -----------------------------------------------------------------------------
# HEADER
# -----------------------------------------------------------------------------
cat << 'EOF'
###############################################################################
# Cecilia v.1.0 - usearCh basEd ampliCon pIpeLine for Illumina dAta
# MIT LICENSE - Copyright © 2022 Gian M.N. Benucci, Ph.D.
# Email: benucci@msu.edu
###############################################################################
EOF

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
cd "${SLURM_SUBMIT_DIR}"
cores=${SLURM_CPUS_PER_TASK}
RAM=${SLURM_MEM_PER_NODE:-32000}

echo -e "\n===> Running script: 10_dereplicateReads_usearch.sb"

source ../config.yaml

# -----------------------------------------------------------------------------
# SETUP DIRECTORIES
# -----------------------------------------------------------------------------
output_dir="$project_dir/outputs/10_dereplicateReads_usearch"
input_dir="$project_dir/outputs/09_filterMaxee_usearch"
mkdir -p "$output_dir"

if [ "$(ls -A "$output_dir")" ]; then
    echo -e "\n$output_dir exists and is not empty! Exiting...\n"
    exit 0
else
   echo -e "\n Creating: $output_dir \n"
   mkdir -p "$output_dir"
fi

# -----------------------------------------------------------------------------
# DEREPLICATION WITH USEARCH
# -----------------------------------------------------------------------------
echo -e "\n========== Dereplicating step for USEARCH clustering ==========\n"
cd "$input_dir"

for file in *.fastq; do
    echo -e "\nProcessing: $file"
    file_name=$(echo "$file" | cut -f 2 -d "_" | cut -f 1 -d ".")
    $USEARCH \
        -threads "$cores" \
        -fastx_uniques "$file" \
        -fastaout "$output_dir/uniques_${file_name}.fasta" \
        -sizeout
done

# -----------------------------------------------------------------------------
# OPTIONAL SWARM DEREPLICATION
# -----------------------------------------------------------------------------
if [[ "$cluster_swarm" == "yes" ]]; then
    echo -e "\n========== Dereplication step for SWARM clustering ==========\n"
    cd "$output_dir"

    module purge
    module load Miniforge3
    conda activate swarm
    echo "Swarm version: $(swarm --version)"

    for file in *.fasta; do
        echo "Linearizing: $file"
        awk '/^>/ {printf("%s%s\t", (N>0?"\n":""), $0); N++; next;} {printf("%s",$0);} END {printf("\n")}' "$file" \
            | tr "\t" "\n" \
            | sed -e 's/\( \).*\(;.\)/\1\2/' \
            | sed 's/ //' \
            | sed 's/.$//' > "${file%.*}_linear.temp"
    done

    for file in *.temp; do
        echo "Clustering: $file"
        swarm \
            --threads "$cores" \
            --differences 0 \
            -w "${file//.temp/.fasta}" \
            -z \
            -o /dev/null "$file"
    done

    conda deactivate

    rm -f "$output_dir"/*.temp
else
    echo -e "\nSkipping SWARM clustering.\n"
fi

# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo -e "\n========== Contents of $output_dir ==================\n"
ls -lh "$output_dir"
echo
echo "Working directory: $(pwd)"

# -----------------------------------------------------------------------------
# SLURM LOG
# -----------------------------------------------------------------------------
echo -e "\n========= Sbatch log ==========\n"
sacct -u "$USER" -j "$SLURM_JOB_ID" --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem
scontrol show job "$SLURM_JOB_ID"

# Move SLURM log to slurms folder
mv "$project_dir"/code/slurm-"$SLURM_JOB_ID"* "$project_dir"/slurms/10_dereplicateReads_usearch.slurm 2>/dev/null || true
