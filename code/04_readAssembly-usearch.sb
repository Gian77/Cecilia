#!/bin/bash -login

#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --job-name=05_assembly
#SBATCH -A glbrc

set -euo pipefail

# -----------------------------------------------------------------------------
# HEADER
# -----------------------------------------------------------------------------
cat << 'EOF'
###############################################################################
# Cecilia v.1.0 - usearCh basEd ampliCon pIpeLine for Illumina dAta
# MIT LICENSE - Copyright © 2022 Gian M.N. Benucci, Ph.D.
# Email: benucci@msu.edu
###############################################################################
EOF

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
cd "${SLURM_SUBMIT_DIR}"
cores=${SLURM_CPUS_PER_TASK}
RAM=${SLURM_MEM_PER_NODE:-128000}

echo "===> Running script: 04_readAssembly-usearch.sb"

# Load config
source ../config.yaml

# -----------------------------------------------------------------------------
# SETUP DIRECTORIES
# -----------------------------------------------------------------------------
input_dir="$project_dir/outputs/03_removePhix_usearch"
output_dir="$project_dir/outputs/04_readAssembly_usearch"
stats_dir="$project_dir/stats"
slurm_dir="$project_dir/slurms"

echo -e "\n========== Creating necessary directories ==========\n"
for dir in "$output_dir" "$stats_dir" "$slurm_dir"; do
    if [ ! -d "$dir" ]; then
        echo "Creating directory: $dir"
        mkdir -p "$dir"
    else
        echo "Directory already exists: $dir"
    fi
done

# Skip if already completed
if compgen -G "$output_dir"/*assembled.fastq > /dev/null; then
    echo -e "\nAssembled files already exist. This step appears complete. Exiting.\n"
    exit 0
fi

# -----------------------------------------------------------------------------
# RUN ASSEMBLY
# -----------------------------------------------------------------------------
cd "$input_dir" || { echo "ERROR: Cannot cd into $input_dir"; exit 1; }

echo -e "\n========== Assembling paired-end reads with USEARCH ==========\n"

while read -r R1; do
    read -r R2
    "$USEARCH" \
        -fastq_mergepairs "$R1" \
        -reverse "$R2" \
        -fastqout "${output_dir}/${R1//nophix.fastq/assembled.fastq}"
done < <(ls *.fastq) # use process substitution

# -----------------------------------------------------------------------------
# COUNT ASSEMBLED READS
# -----------------------------------------------------------------------------
echo -e "\n========== Counting assembled reads ==========\n"

count_file="$stats_dir/03.assembled.counts"
> "$count_file"

cd "$output_dir" || exit 1

for file in *assembled.fastq; do
    [ -f "$file" ] || continue
    count=$(($(wc -l < "$file") / 4))
    echo "$(basename "$file") : $count" | tee -a "$count_file"
done

# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo -e "\n========== Contents of "$output_dir" ==================\n"
ls -lh "$output_dir"

echo "\nWorking directory: $(pwd)"
# -----------------------------------------------------------------------------
# SLURM JOB LOGGING
# -----------------------------------------------------------------------------
echo -e "\n========== SLURM Job Info ==========\n"
sacct -u "$USER" -j "$SLURM_JOB_ID" --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem
scontrol show job "$SLURM_JOB_ID"

mv "$project_dir/code/slurm-$SLURM_JOB_ID"* "$slurm_dir/04_readAssembly-usearch.slurm" 2>/dev/null || true
