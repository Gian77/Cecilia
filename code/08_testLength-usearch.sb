#!/bin/bash -login

#SBATCH --time=14:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=64G
#SBATCH --job-name 08_testlength
#SBATCH -A shade-cole-bonito

set -euo pipefail

# -----------------------------------------------------------------------------
# HEADER
# -----------------------------------------------------------------------------
cat << 'EOF'
###############################################################################
# Cecilia v.1.0 - usearCh basEd ampliCon pIpeLine for Illumina dAta
# MIT LICENSE - Copyright © 2022 Gian M.N. Benucci, Ph.D.
# Email: benucci@msu.edu
###############################################################################
EOF

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
cd "${SLURM_SUBMIT_DIR}"
cores=${SLURM_CPUS_PER_TASK}
RAM=${SLURM_MEM_PER_NODE:-32000}

echo "===> Running script: 08_testLength-usearch.sb"

# Load config
source ../config.yaml

# -----------------------------------------------------------------------------
# SETUP DIRECTORIES
# -----------------------------------------------------------------------------
output_dir="$project_dir/outputs/08_testLength_usearch"
slurm_dir="$project_dir/slurms"
stats_dir="$project_dir/stats"

echo -e "\n========== Creating necessary directories ==========\n"
for dir in "$output_dir" "$slurm_dir" "$stats_dir"; do
    if [ ! -d "$dir" ]; then
        echo "Creating directory: $dir"
        mkdir -p "$dir"
    else
        echo "Directory already exists: $dir"
    fi
done

# -----------------------------------------------------------------------------
# CHECK COMPLETION
# -----------------------------------------------------------------------------
if [ "$(ls -A "$output_dir")" ]; then
    echo -e "\nDirectory exists and is not empty! This step was already performed. Exiting...\n"
    exit 0
fi

# -----------------------------------------------------------------------------
# CLUSTER OTUs AT EACH BP LENGTH
# -----------------------------------------------------------------------------

echo -e "\n========== Generate number of OTUs at each length tested ==========\n"

# Choose source file based on stripleft setting
if [[ "$stripleft" == "yes" ]]; then
    sed '1~4s/.*\./@newstring./g' "$project_dir/outputs/07_readTrimDemux_usearch/trimmed.fastq" > \
        "$output_dir/trimmed_renamed.fasta"
    source_file="$output_dir/trimmed_renamed.fasta"
    echo -e "\nUsing trimmed reads at: $source_file\n"
else
    sed '1~4s/.*\./@newstring./g' "$project_dir/outputs/06_primerStrip_cutadapt/pooled.fastq" > \
        "$output_dir/pooled_renamed.fasta"
    source_file="$output_dir/pooled_renamed.fasta"
    echo -e "\nUsing non-trimmed reads at: $source_file\n"
fi

# Initialize results file
results_file="$output_dir/testLength.results"
echo -e "Length\tFiltered\tUniques\tOtus" > "$results_file"

# Loop over sequence lengths
for i in $(seq -w 150 300); do
    $USEARCH -threads "$cores" \
        -fastq_filter "$source_file" \
        -fastq_maxee "$max_Eerr" \
        -fastq_stripleft "$stripleft_bp" \
        -fastq_trunclen "$i" \
        -fastq_maxns 0 \
        -fastqout "$output_dir/filtered_${i}.fastq"

    $USEARCH -threads "$cores" \
        -fastx_uniques "$output_dir/filtered_${i}.fastq" \
        -fastaout "$output_dir/uniques_${i}.fasta" \
        -sizeout

    $USEARCH -threads "$cores" \
        -minsize 2 \
        -relabel OTU_ \
        -cluster_otus "$output_dir/uniques_${i}.fasta" \
        -otus "$output_dir/otus_${i}.fasta" \
        -uparseout "$output_dir/uparse_otus_${i}.txt"

    # Count stats
    filt=$(grep -c "^@newstring" "$output_dir/filtered_${i}.fastq")
    unique=$(grep -c "^>newstring" "$output_dir/uniques_${i}.fasta")
    otu=$(grep -c "^>OTU" "$output_dir/otus_${i}.fasta")
    echo -e "$i\t$filt\t$unique\t$otu" >> "$results_file"

    # Cleanup
    rm -f "$output_dir"/filtered_${i}.fastq \
          "$output_dir"/uniques_${i}.fasta \
          "$output_dir"/otus_${i}.fasta \
          "$output_dir"/uparse_otus_${i}.txt
done

# -----------------------------------------------------------------------------
# PLOTTING WITH R
# -----------------------------------------------------------------------------
echo -e "\n========== Plotting OTU number by read length ==========\n"
module purge
module load Miniforge3
conda activate R
cd "$output_dir"
Rscript "$project_dir/code/testLength.R"
conda deactivate

# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo -e "\n========== Contents of $output_dir ==================\n"
ls -lh "$output_dir"
echo
echo "Working directory: $(pwd)"

# -----------------------------------------------------------------------------
# SLURM LOG
# -----------------------------------------------------------------------------
echo -e "\n========== Sbatch log ==========\n"
sacct -u "$USER" -j "$SLURM_JOB_ID" --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem
scontrol show job "$SLURM_JOB_ID"

# Move SLURM log to slurms folder
mv "$project_dir"/code/slurm-"$SLURM_JOB_ID"* "$project_dir"/slurms/08_testLength-usearch.slurm 2>/dev/null || true
