#!/bin/bash -login

#SBATCH --time=03:59:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --job-name=12_clusterUNOISE
#SBATCH -A shade-cole-bonito

set -euo pipefail

# -----------------------------------------------------------------------------
# HEADER
# -----------------------------------------------------------------------------
cat << 'EOF'
###############################################################################
# Cecilia v.1.0 - usearCh basEd ampliCon pIpeLine for Illumina dAta
# MIT LICENSE - Copyright © 2022 Gian M.N. Benucci, Ph.D.
# Email: benucci@msu.edu
###############################################################################
EOF

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
cd "${SLURM_SUBMIT_DIR}"
cores="${SLURM_CPUS_PER_TASK}"
RAM="${SLURM_MEM_PER_NODE:-128000}"

echo "===> Running script: 12_clusterUNOISE_usearch.sb"

# Load config
source ../config.yaml

# -----------------------------------------------------------------------------
# SETUP DIRECTORIES
# -----------------------------------------------------------------------------
output_dir="$project_dir/outputs/11_clustered_otu_asv_usearch"
input_dir="$project_dir/outputs/10_dereplicateReads_usearch"
mkdir -p "$output_dir"
mkdir -p "$output_dir/extra"

echo -e "\n========== Sub-directories ==========\n"
echo "Input directory : $input_dir"
echo "Output directory: $output_dir"
echo "Extra files directory: $output_dir/extra"
# -----------------------------------------------------------------------------
# GENERATE ASVs AND BUILD OTU TABLE
# -----------------------------------------------------------------------------
cd "$input_dir"
for file in unique*.fasta; do
    [ -f "$file" ] || continue
    echo -e "\n========== Generating ASVs for $(basename "$file") ==========\n"
    file_name=$(basename "$file" | cut -f2 -d"_" | cut -f1 -d".")

    $USEARCH \
        -unoise3 "$file" \
        -minsize "$zotu_min_size" \
        -tabbedout "$output_dir/extra/unoise_asv_${file_name}.txt" \
        -zotus "$output_dir/asv_${file_name}.fasta"

	awk '/^>/ {printf(">asv_%03d\n", ++i); next} {print}' "$output_dir/asv_${file_name}.fasta" > "$output_dir/asv_${file_name}.fasta.tmp"
	mv "$output_dir/asv_${file_name}.fasta.tmp" "$output_dir/asv_${file_name}.fasta"

    echo -e "\n========== Generating OTU table for $file_name ==========\n"
    $USEARCH \
        -threads "$cores" \
        -otutab "$project_dir/outputs/06_primerStrip_cutadapt/pooled.fastq" \
        -zotus "$output_dir/asv_${file_name}.fasta" \
        -otutabout "$output_dir/asvtable_UNOISE_${file_name}.txt"
done
# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo -e "\n========== Contents of $output_dir ==================\n"
ls -lh "$output_dir"
echo
echo "Working directory: $(pwd)"
# -----------------------------------------------------------------------------
# LOG
# -----------------------------------------------------------------------------
echo -e "\n========= Sbatch log =========\n"
sacct -u "$USER" -j "$SLURM_JOB_ID" --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem || true
echo
scontrol show job "$SLURM_JOB_ID" || true
# Move SLURM log to slurms folder
mv "$project_dir"/code/slurm-"$SLURM_JOB_ID"* "$project_dir"/slurms/12_clusterUNOISE_usearch.slurm 2>/dev/null || true
