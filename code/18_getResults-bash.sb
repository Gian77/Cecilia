#!/bin/bash -login
#SBATCH --time=00:10:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --job-name 16getStats
#SBATCH -A shade-cole-bonito

# -----------------------------------------------------------------------------
# HEADER
# -----------------------------------------------------------------------------
cat << 'EOF'
###############################################################################
# Cecilia v.1.0 - usearCh basEd ampliCon pIpeLine for Illumina dAta
# MIT LICENSE - Copyright © 2022 Gian M.N. Benucci, Ph.D.
# Email: benucci@msu.edu
###############################################################################
EOF

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
cd "${SLURM_SUBMIT_DIR}"
cores="${SLURM_CPUS_PER_TASK}"
RAM="${SLURM_MEM_PER_NODE:-256000}"

echo "===> Running script: 18_getResults-bash.sb"

# Load config
source ../config.yaml

# -----------------------------------------------------------------------------
# SETUP DIRECTORIES
# -----------------------------------------------------------------------------
output_dir="$project_dir/outputs/16_getResults_bash"
cecilia_dir="$output_dir/Cecilia-results"
mkdir -p "$output_dir"
mkdir -p "$cecilia_dir"

echo -e "\n========== Creating output directories ==========\n"
echo "Output directory: $output_dir"
echo "Results directory : $cecilia_dir"

# -----------------------------------------------------------------------------
# COLLECT FILES
# -----------------------------------------------------------------------------
echo -e "\n========== Collecting Cecilia results ==========\n"

# -----------------------------------------------------------------------------
# COPY CONFIG AND STATs
# -----------------------------------------------------------------------------
cp "$project_dir/config.yaml" "$cecilia_dir/config.yaml"
cp "$project_dir/stats/*.counts" "$cecilia_dir/"

# -----------------------------------------------------------------------------
# COPY FASTQ FILEs
# -----------------------------------------------------------------------------
[ -d "$project_dir/outputs/02_rawQuality_fqc/" ] && \
  cp -R "$project_dir/outputs/02_rawQuality_fqc/*.html" "$cecilia_dir/rawQuality_stats/"

# -----------------------------------------------------------------------------
# COPY FILE TO MATCH NEW SAMPLE NAMEs TO ORIGINAL NAMEs
# -----------------------------------------------------------------------------
cp "$project_dir/outputs05_readRenamed_bash/file_mapping.txt" "$cecilia_dir/sample_names_match.txt"

# -----------------------------------------------------------------------------
# COPY CHECK FILE: EQUAL READ NUMBER IN R1 AND R2 AND .fasta SUBSET
# -----------------------------------------------------------------------------
[ -s "$project_dir/outputs/06_primerStrip_cutadapt/sequence_quality_nomatch.counts" ] && \
  cp "$project_dir/outputs/06_primerStrip_cutadapt/sequence_quality_nomatch.counts" "$cecilia_dir/"
cp "$project_dir/outputs/06_primerStrip_cutadapt/subset_500.fasta" "$cecilia_dir/"

# -----------------------------------------------------------------------------
# COPY MAX EXPECTED ERROR FILE
# -----------------------------------------------------------------------------
cp "$project_dir/outputs/07_readTrimDemux_usearch/eestats2.results" "$cecilia_dir/"

# -----------------------------------------------------------------------------
# COPY TEST-LENGTH DATAFRAMEs AND PDF PLTOs
# -----------------------------------------------------------------------------
[ -s "$project_dir/outputs/08_testLength_usearch/testLength.results" ] && \
  cp "$project_dir/outputs/08_testLength_usearch/testLength.results" "$cecilia_dir/"
[ -s "$project_dir/outputs/08_testLength_usearch/bpLength-log2.pdf" ] && \
  cp "$project_dir/outputs/08_testLength_usearch/bpLength-log2.pdf" "$cecilia_dir/"
[ -s "$project_dir/outputs/08_testLength_usearch/bpLength.pdf" ] && \
  cp "$project_dir/outputs/08_testLength_usearch/bpLength.pdf" "$cecilia_dir/"
[ -s "$project_dir/outputs/08_testLength_usearch/bpLength-faceted.pdf" ] && \
  cp "$project_dir/outputs/08_testLength_usearch/bpLength-faceted.pdf" "$cecilia_dir/"

# -----------------------------------------------------------------------------
# COPY FASTQC RUNs ON FILETRED DATASETs
# -----------------------------------------------------------------------------
cp "$project_dir/outputs/09_filterMaxee_usearch/"*fastqc.html "$cecilia_dir/" 2>/dev/null || true

# -----------------------------------------------------------------------------
# COPY ASV, OTUs, and TABLES
# -----------------------------------------------------------------------------
cp "$project_dir/outputs/11_clustered_otu_asv_usearch/"* "$cecilia_dir/" 2>/dev/null || true

# -----------------------------------------------------------------------------
# COPY TAXONOMY OUTPUTS IF PRESENT
# -----------------------------------------------------------------------------
found_any=false

if compgen -G "$project_dir/outputs/12_taxonomy_constax*" > /dev/null; then
    echo "Copying CONSTAX taxonomy results..."
    cp -R "$project_dir/outputs/12_taxonomy_constax"*/ "$cecilia_dir/"
    found_any=true
fi

#if compgen -G "$project_dir/outputs/13_taxonomy_sintax*" > /dev/null; then
#    echo "Copying SINTAX taxonomy results..."
#    cp -R "$project_dir/outputs/13_taxonomy_sintax"*/ "$cecilia_dir/"
#    mv "$cecilia_dir/13_taxonomy_sintax"  "$cecilia_dir/taxonomy_sintax"
#    rm "$cecilia_dir/taxonomy_sintax/*.udb"
#    found_any=true
#fi

if compgen -G "$project_dir/outputs/13_taxonomy_sintax*" > /dev/null; then
    echo "Copying SINTAX taxonomy results..."
    rsync -a --exclude='*.udb' "$project_dir/outputs/13_taxonomy_sintax"/ "$cecilia_dir/taxonomy_sintax"/
    found_any=true
fi



if [ "$found_any" = false ]; then
    echo "No taxonomy output directories found to copy."
fi


# -----------------------------------------------------------------------------
# SLURM RUNTIME STATS
# -----------------------------------------------------------------------------
echo -e "\n========== Collecting SLURM runtime stats ==========\n"
mkdir -p "$cecilia_dir/slurms"
cd "$project_dir/slurms/"
for file in *.slurm; do
    paste <(tail -n33 "$file" | head -n1) <(tail -n24 "$file" | head -n1)
done > "$cecilia_dir/runtime.results"
cp -R "$project_dir/slurms/" "$cecilia_dir/slurms/"

# -----------------------------------------------------------------------------
# PACKAGE RESULTS
# -----------------------------------------------------------------------------
cd "$output_dir"
results_prefix="Cecilia-results"
suffix=""

if [[ "$R1" == "yes" && "$R2" == "yes" ]]; then
    suffix="assembled"
elif [[ "$R1" == "yes" ]]; then
    suffix="R1"
elif [[ "$R2" == "yes" ]]; then
    suffix="R2"
else
    suffix="unpaired"
fi

timestamp=$(date +"%d-%m-%Y")
final_dir="${results_prefix}_${suffix}_${timestamp}"
tar_file="${final_dir}.tar.gz"

mv "$cecilia_dir" "$output_dir/$final_dir"
tar -zcvf "$tar_file" "$final_dir"
cp "$tar_file" "$project_dir/$tar_file"

# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo -e "\n========== Contents of $output_dir ==================\n"
ls -lh "$output_dir"
echo
echo "Working directory: $(pwd)"

# -----------------------------------------------------------------------------
# SBATCH LOG
# -----------------------------------------------------------------------------
echo -e "\n========= Sbatch log =========\n"
echo -e "\nCurrent directory: $(pwd)\n"
sacct -u "$USER" -j "$SLURM_JOB_ID" --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem
scontrol show job "$SLURM_JOB_ID"

# Move SLURM log to slurms folder
mv "$project_dir/code/slurm-$SLURM_JOB_ID"* "$project_dir/slurms/16_getResults-bash.slurm" 2>/dev/null || true
