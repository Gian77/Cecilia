#!/bin/bash -login

#SBATCH --time=00:15:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --job-name=01_decompress

set -euo pipefail  # safer: exit on error, undefined vars, or broken pipes

# -----------------------------------------------------------------------------
# HEADER
# -----------------------------------------------------------------------------
cat << 'EOF'
###############################################################################
# Cecilia v.1.0 - usearCh basEd ampliCon pIpeLine for Illumina dAta
# MIT License - Copyright © 2022 Gian M.N. Benucci, Ph.D.
# Email: benucci@msu.edu
###############################################################################
EOF

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
cd "${SLURM_SUBMIT_DIR}"
cores=${SLURM_CPUS_PER_TASK}
RAM=${SLURM_MEM_PER_NODE:-64000}  # default if not set

echo "===> Running script: 01_decompress-bash.sb"

# Source config
source ../config.yaml

# -----------------------------------------------------------------------------
# SETUP DIRECTORIES
# -----------------------------------------------------------------------------
echo -e "\n========== Creating main project directories ==========\n"

for dir in "$project_dir/outputs" "$project_dir/slurms" "$project_dir/stats" "$project_dir/outputs/01_decompressed"; do
    if [ ! -d "$dir" ]; then
        echo "Creating directory: $dir"
        mkdir -p "$dir"
    else
        echo "Directory already exists: $dir"
    fi
done

# Define output directory for decompressed files
decomp_dir="$project_dir/outputs/01_decompressed"

# -----------------------------------------------------------------------------
# DECOMPRESS FILES
# -----------------------------------------------------------------------------
cd "$project_dir/rawdata" || { echo "ERROR: Cannot cd into rawdata directory"; exit 1; }

echo -e "\n========== Decompressing raw FASTQ files ==========\n"
echo "Output directory: $decomp_dir"

for file in *.fastq*; do
    if [[ "$file" == *.fastq.bz2 ]]; then
        echo -e "\n==> $file is in BZ2 format"
        out_file="${file%.bz2}"
        out_path="$decomp_dir/$out_file"
        if [[ -f "$out_path" ]]; then
            echo "   Skipping: already decompressed"
        else
            echo "   Decompressing to $out_path..."
            bzip2 -cd < "$file" > "$out_path"
        fi

    elif [[ "$file" == *.fastq.gz ]]; then
        echo -e "\n==> $file is in GZ format"
        out_file="${file%.gz}"
        out_path="$decomp_dir/$out_file"
        if [[ -f "$out_path" ]]; then
            echo "   Skipping: already decompressed"
        else
            echo "   Decompressing to $out_path..."
            gzip -cd < "$file" > "$out_path"
        fi

    elif [[ "$file" == *.fastq.tar.gz ]]; then
        echo -e "\n==> $file is in TAR.GZ format"
        echo "   Note: .tar.gz is not supported by this step — skipping"
        continue

    elif [[ "$file" == *.fastq ]]; then
        echo -e "\n==> $file is already in FASTQ format. Copying to output directory."
        out_path="$decomp_dir/$file"
        if [[ -f "$out_path" ]]; then
            echo "   Skipping: already exists in output"
        else
            echo "   Copying to $out_path..."
            cp "$file" "$out_path"
        fi

    else
        echo -e "\n==> $file has unsupported format. Skipping."
    fi
done

# -----------------------------------------------------------------------------
# RENAME NON-STANDARD FILES (1_1 / 1_2 to R1 / R2)
# -----------------------------------------------------------------------------
cd "$decomp_dir" || { echo "ERROR: Cannot cd into decompressed directory"; exit 1; }

shopt -s nullglob  # avoid literal pattern matching when no match is found
rename_needed=false

for file in *1_1.fastq; do
    [ -f "$file" ] || continue
    [ "$rename_needed" = false ] && echo -e "\n========== Renaming non-standard FASTQ filenames ==========\n" && rename_needed=true
    new_name="${file//1_1.fastq/R1.fastq}"
    echo "Renaming $file → $new_name"
    mv "$file" "$new_name"
done

for file in *1_2.fastq; do
    [ -f "$file" ] || continue
    [ "$rename_needed" = false ] && echo -e "\n========== Renaming non-standard FASTQ filenames ==========\n" && rename_needed=true
    new_name="${file//1_2.fastq/R2.fastq}"
    echo "Renaming $file → $new_name"
    mv "$file" "$new_name"
done

# -----------------------------------------------------------------------------
# SUMMARY
# -----------------------------------------------------------------------------
echo -e "\n========== Contents of $decomp_dir ===================\n"
ls -lh "$decomp_dir"
echo -e "\nWorking directory: $(pwd)\n"

echo -e "\n========== Disk usage ==========\n"
du -sh "$project_dir/rawdata"
du -sh "$decomp_dir"

# -----------------------------------------------------------------------------
# SLURM JOB LOGGING
# -----------------------------------------------------------------------------
echo -e "\n========== SLURM Job Info ==========\n"
sacct -u "$USER" -j "$SLURM_JOB_ID" --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem
scontrol show job "$SLURM_JOB_ID"

# Move SLURM log to slurms folder
mv "$project_dir/code/slurm-$SLURM_JOB_ID"* "$project_dir/slurms/01_decompress-bash.slurm" 2>/dev/null || true

