// =============================================================================
// Cecilia-nf  —  nextflow.config
// Replaces config.yaml. All user-facing parameters live in params {}.
// USEARCH binary is proprietary: it is NOT containerised. It is mounted from
// the host into every Singularity container via singularity.runOptions below.
// =============================================================================

params {

    // -------------------------------------------------------------------------
    // INPUT / OUTPUT
    // -------------------------------------------------------------------------
    rawdata  = "${projectDir}/../rawdata"
    outdir   = "${projectDir}/../outputs"

    // -------------------------------------------------------------------------
    // TOOLS  (host paths, bound into containers)
    // -------------------------------------------------------------------------
    usearch  = "/mnt/research/glbrc_group/benuccigmn/TOOLS/usearch11.0.667_i86linux64"

    // -------------------------------------------------------------------------
    // DATABASES
    // -------------------------------------------------------------------------
    sintax_db     = "/mnt/research/glbrc_group/benuccigmn/DATABASES/SILVA/SILVA_138_SSURef_tax_silva_bact_arch_sintax.fasta"
    closedRef_db  = "/mnt/research/glbrc_group/benuccigmn/DATABASES/CLOSED_REF_DBs/syncom_n40_ref_seeds.fasta"

    // -------------------------------------------------------------------------
    // DNA MARKER & READ LAYOUT
    // -------------------------------------------------------------------------
    dna_marker = "16S"
    paired     = true    // true = R1+R2, false = single-end

    // -------------------------------------------------------------------------
    // PIPELINE FLOW FLAGS
    // -------------------------------------------------------------------------
    assemble           = true
    rename             = true
    primers            = true
    stripleft          = false
    stripleft_bp       = 0
    test_length        = false   // optional length-sweep subworkflow (off by default)
    cluster_otu        = true
    cluster_asv        = true
    cluster_asv_to_otu = true    // requires cluster_asv = true
    cluster_swarm      = true
    closed_ref_otu     = true
    sintax_taxonomy    = true

    // -------------------------------------------------------------------------
    // PRIMER SEQUENCES
    // -------------------------------------------------------------------------
    fwd_primer    = "GTGCCAGCMGCCGCGGTAA"     // 515F  (Parada / Caporaso)
    rev_primer    = "GGACTACHVGGGTWTCTAAT"     // 806R  (Apprill / Caporaso)
    rev_primer_rc = "ATTAGAWACCCBDGTAGTCC"     // 806R  reverse complement

    // -------------------------------------------------------------------------
    // QUALITY FILTERING
    // -------------------------------------------------------------------------
    max_eerr       = 1.0
    filter_lengths = [200, 225, 250]   // truncation lengths tested in FILTER_MAXEE
    user_length    = 290               // extra user-defined truncation length
    min_overlap    = 0
    count_start    = "01"

    // -------------------------------------------------------------------------
    // CLUSTERING
    // -------------------------------------------------------------------------
    otu_min_size  = 1
    zotu_min_size = 8
    clustering_id = 0.97

    // -------------------------------------------------------------------------
    // TAXONOMY
    // -------------------------------------------------------------------------
    sintax_cutoff = 0.8

    // -------------------------------------------------------------------------
    // SLURM
    // -------------------------------------------------------------------------
    slurm_account = "glbrc"
}

// =============================================================================
// PER-PROCESS RESOURCES AND CONTAINERS
// Containers for USEARCH steps use ubuntu:22.04; the binary is bound from host.
// =============================================================================
process {
    executor       = 'slurm'
    clusterOptions = "--account=${params.slurm_account}"

    withName: 'DECOMPRESS' {
        cpus      = 16
        memory    = '64 GB'
        time      = '15m'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'FASTQC' {
        cpus          = 8
        memory        = '32 GB'
        time          = '1h'
        container     = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
        // SIGBUS on parallel filesystems is transient; retry once before failing
        errorStrategy = 'retry'
        maxRetries    = 1
    }
    withName: 'REMOVE_PHIX' {
        cpus      = 8
        memory    = '32 GB'
        time      = '30m'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'ASSEMBLE_READS' {
        cpus      = 16
        memory    = '128 GB'
        time      = '12h'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'RENAME_READS' {
        cpus      = 8
        memory    = '32 GB'
        time      = '30m'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'STRIP_PRIMERS' {
        cpus      = 16
        memory    = '32 GB'
        time      = '30m'
        container = 'quay.io/biocontainers/cutadapt:4.9--py312h0451450_0'
    }
    withName: 'POOL_READS' {
        cpus      = 4
        memory    = '16 GB'
        time      = '15m'
        container = 'quay.io/biocontainers/seqtk:1.4--he4a0461_1'
    }
    withName: 'EE_STATS' {
        cpus      = 8
        memory    = '32 GB'
        time      = '4h'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'TEST_LENGTH' {
        cpus      = 16
        memory    = '128 GB'
        time      = '4h'
        // rocker/tidyverse includes tidyverse + ggplot2; USEARCH is bind-mounted
        container = 'docker://rocker/tidyverse:4.3.1'
    }
    withName: 'FILTER_MAXEE' {
        cpus      = 8
        memory    = '32 GB'
        time      = '1h'
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }
    withName: 'DEREPLICATE' {
        cpus      = 8
        memory    = '32 GB'
        time      = '4h'
        container = 'quay.io/biocontainers/swarm:3.1.5--h9f5acd7_0'
    }
    withName: 'CLUSTER_UPARSE' {
        cpus      = 32
        memory    = '256 GB'
        time      = '10h'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'CLUSTER_UNOISE' {
        cpus      = 16
        memory    = '128 GB'
        time      = '10h'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'CLUSTER_ASV_TO_OTU' {
        cpus      = 16
        memory    = '128 GB'
        time      = '4h'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'CLOSED_REF_OTU' {
        cpus      = 16
        memory    = '128 GB'
        time      = '4h'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'CLUSTER_SWARM' {
        cpus      = 16
        memory    = '64 GB'
        time      = '4h'
        container = 'quay.io/biocontainers/swarm:3.1.5--h9f5acd7_0'
    }
    withName: 'BUILD_SINTAX_DB' {
        cpus      = 4
        memory    = '32 GB'
        time      = '1h'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'TAXONOMY_SINTAX' {
        cpus      = 32
        memory    = '392 GB'
        time      = '10h'
        container = 'docker://ubuntu:22.04'
    }
    withName: 'COLLECT_RESULTS' {
        cpus      = 4
        memory    = '32 GB'
        time      = '15m'
        container = 'docker://ubuntu:22.04'
    }
}

// =============================================================================
// SINGULARITY
// Mounts the host /mnt/research and /mnt/home trees so USEARCH, databases,
// and isolate FASTAs are all reachable inside every container.
// =============================================================================
singularity {
    enabled    = true
    autoMounts = true
    // Persistent image cache on research storage — avoids re-pulling on every run
    cacheDir   = "/mnt/research/glbrc_group/benuccigmn/singularity_cache"
    // Bind host research+home trees (USEARCH, databases) and /tmp (JVM temp I/O)
    runOptions = "--bind /mnt/research:/mnt/research --bind /mnt/home:/mnt/home --bind /tmp:/tmp"
}

// =============================================================================
// PROFILES
// =============================================================================
profiles {
    slurm {
        process.executor = 'slurm'
    }
    local {
        process.executor    = 'local'
        singularity.enabled = false
    }
    test {
        process.executor    = 'local'
        singularity.enabled = false
        params.rawdata      = "${projectDir}/../testing/euk_test"
        params.test_length  = false
        params.cluster_swarm = false
    }
}

// =============================================================================
// REPORTING  (written to outdir after each run)
// =============================================================================
report {
    enabled   = true
    file      = "${params.outdir}/cecilia_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/cecilia_timeline.html"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/cecilia_dag.html"
    overwrite = true
}
